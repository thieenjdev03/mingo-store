# Base URL của NestJS API, không kèm dấu "/" ở cuối.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL canonical công khai của storefront, không có dấu "/" ở cuối.
# Đây là NGUỒN DUY NHẤT sinh canonical / og:url / sitemap / JSON-LD.
# Production PHẢI là domain thương hiệu; nếu để alias *.vercel.app thì domain
# thương hiệu sẽ tự khai mình là bản sao của vercel và không được index.
# Preview/staging: để trống hoặc set domain khác -> robots.ts tự trả Disallow: /.
NEXT_PUBLIC_SITE_URL=https://mingocream.hongtanphat.com
