# Base URL nội bộ của NestJS API, chỉ đọc ở Next.js server/BFF, không kèm "/" ở cuối.
# Không dùng NEXT_PUBLIC_ để endpoint thật không bị đóng gói vào JavaScript gửi xuống browser.
API_URL=http://localhost:3000

# Khóa HMAC ký session admin, tối thiểu 32 ký tự. Tạo bằng: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-long-random-production-secret

# Phí vận chuyển cố định (VND) hiển thị ở checkout. Đặt theo chính sách vận hành.
NEXT_PUBLIC_SHIPPING_FEE=0

# Chương trình tặng kem miễn phí. Đổi giá trị rồi build/deploy lại storefront.
# true: bật chương trình; false: kết thúc chương trình và UI hiển thị ngưỡng vô cực.
NEXT_PUBLIC_FREE_ICE_CREAM_REWARD_ENABLED=true
# Số điểm cần để nhận kem miễn phí khi chương trình đang bật.
NEXT_PUBLIC_FREE_ICE_CREAM_REWARD_POINTS=1500

# URL canonical công khai của storefront, không có dấu "/" ở cuối.
NEXT_PUBLIC_SITE_URL=https://mingo-store.vercel.app
