# Base URL nội bộ của NestJS API, chỉ đọc ở Next.js server (SSR/ISR), không kèm "/" ở cuối.
API_URL=http://localhost:3000

# Cùng backend, nhưng đây là biến NEXT_PUBLIC_ vì browser gọi thẳng backend
# (không qua proxy BFF nữa) — endpoint này vốn đã public qua Swagger/CORS.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL canonical công khai của storefront, không có dấu "/" ở cuối.
NEXT_PUBLIC_SITE_URL=https://mingo-store.vercel.app
